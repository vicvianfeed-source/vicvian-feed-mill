{
  "name": "ServiceJob",
  "type": "object",
  "properties": {
    "service_id": {
      "type": "string"
    },
    "service_name": {
      "type": "string"
    },
    "customer_name": {
      "type": "string"
    },
    "grain_type": {
      "type": "string"
    },
    "pellet_size": {
      "type": "string",
      "enum": [
        "2mm",
        "4mm",
        "6mm"
      ]
    },
    "quantity_kg": {
      "type": "number"
    },
    "rate_per_kg": {
      "type": "number"
    },
    "total": {
      "type": "number"
    },
    "operator_email": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "completed",
        "void"
      ],
      "default": "completed"
    }
  },
  "required": [
    "service_id",
    "customer_name",
    "quantity_kg",
    "total"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "manager"
          }
        },
        {
          "user_condition": {
            "role": "operator"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "manager"
          }
        },
        {
          "user_condition": {
            "role": "operator"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}