{
  "name": "Purchase",
  "type": "object",
  "properties": {
    "product_id": {
      "type": "string"
    },
    "product_name": {
      "type": "string"
    },
    "supplier": {
      "type": "string"
    },
    "quantity": {
      "type": "number"
    },
    "unit_cost": {
      "type": "number"
    },
    "total_cost": {
      "type": "number"
    },
    "purchase_date": {
      "type": "string",
      "format": "date"
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "cash",
        "bank_transfer",
        "mobile_money",
        "credit"
      ],
      "default": "cash"
    },
    "recorded_by": {
      "type": "string"
    }
  },
  "required": [
    "product_id",
    "supplier",
    "quantity",
    "unit_cost"
  ]
}