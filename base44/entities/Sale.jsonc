{
  "name": "Sale",
  "type": "object",
  "properties": {
    "product_id": {
      "type": "string"
    },
    "product_name": {
      "type": "string"
    },
    "domain": {
      "type": "string",
      "enum": [
        "feed_mill",
        "fish_farm"
      ]
    },
    "quantity": {
      "type": "number"
    },
    "unit_price": {
      "type": "number"
    },
    "total": {
      "type": "number"
    },
    "customer_name": {
      "type": "string"
    },
    "sale_date": {
      "type": "string",
      "format": "date"
    },
    "operator_email": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "completed",
        "void"
      ],
      "default": "completed"
    }
  },
  "required": [
    "product_id",
    "quantity",
    "unit_price",
    "total"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "manager"
          }
        },
        {
          "user_condition": {
            "role": "operator"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "manager"
          }
        },
        {
          "user_condition": {
            "role": "operator"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "manager"
          }
        },
        {
          "user_condition": {
            "role": "operator"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}